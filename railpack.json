{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        { "src": ".", "dest": "." },
        "npm ci --workspace=apps/web --workspace=packages/core --include-workspace-root"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["npm run -w apps/web build"]
    }
  }
}
