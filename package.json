{
  "name": "slashfacts",
  "private": true,
  "version": "1.1.1",
  "license": "GPL-3.0-only",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run -w apps/mobile web",
    "build": "npm run -w apps/mobile build:web",
    "start": "node apps/mobile/server.mjs",
    "test": "npm run -w packages/core test",
    "typecheck": "npm run -w packages/core typecheck && npm run -w apps/mobile typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
